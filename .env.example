# Postgres connection (Neon or Vercel Postgres). Leave empty to use an embedded
# PGlite database stored in ./.pglite for local development.
DATABASE_URL=

# Secret used to sign buyer session cookies. Use a long random string in production.
SESSION_SECRET=change-me

# SMS: "console" (logs messages, default) or "africastalking"
SMS_PROVIDER=console
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=

# Pilot settings
PILOT_CROP=soybeans
PILOT_PROVINCE=Central
USSD_WEBHOOK_KEY=
